# ── Runtime mode ──────────────────────────────────────────────────────────────
# Set to "true" to run as a RunPod serverless handler instead of HTTP server.
RUNPOD_ENABLED=false

# Pre-load weights at startup. Use true on persistent GPU pods and false on
# serverless workers when startup time matters more than the first request.
# When R2_ENABLED=true, this also triggers the R2 download before GPU loading.
PRELOAD_MODELS=false

# Flask / Gunicorn (ignored when RUNPOD_ENABLED=true)
PORT=5000

# Protects all generation routes when set. Send X-API-Key or Bearer token.
# API_KEY=replace-with-a-long-random-secret

# Reject oversized reference-image requests before they consume memory.
MAX_REQUEST_MB=32

# ── Model ─────────────────────────────────────────────────────────────────────
# HuggingFace token. Required for gated FLUX.2-dev and its remote text encoder.
# HF_TOKEN=hf_...

# Study/research profile: 32B model, quantized to 4-bit for a 24 GB GPU.
MODEL_ID=black-forest-labs/FLUX.2-dev
FLUX2_DEV_4BIT=true
FLUX2_DEV_QUANTIZED_MODEL_ID=diffusers/FLUX.2-dev-bnb-4bit
FLUX2_TEXT_ENCODER_MODE=remote
# FLUX2_REMOTE_TEXT_ENCODER_URL=https://remote-text-encoder-flux-2.huggingface.co/predict

# Conversation memory. On RunPod, mount a Network Volume at this path.
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_DIR=/data/conversations
CONVERSATION_MAX_REVISIONS=10

# Lower-cost alternative:
# MODEL_ID=black-forest-labs/FLUX.2-klein-4B

# Legacy profiles remain supported:
# MODEL_ID=black-forest-labs/FLUX.1-schnell
# MODEL_ID=black-forest-labs/FLUX.1-dev

# The official 4-bit + remote encoder profile fits a 24 GB GPU without offload.
# Enable only when VRAM is insufficient; it increases latency substantially.
MODEL_CPU_OFFLOAD=false

# HuggingFace cache directory
# HF_HOME=/cache/huggingface

# ControlNet adapter model (Apache 2.0 — no token needed)
# CONTROLNET_MODEL_ID=InstantX/FLUX.1-dev-Controlnet-Canny

# Set to "false" to skip downloading the ControlNet adapter on startup
# DOWNLOAD_CONTROLNET=true

# ── Cloudflare R2 model cache ─────────────────────────────────────────────────
# Enables the R2 strategy: download model from R2 on cold start instead of
# HuggingFace. No region lock, free egress, global availability.
#
# Setup:
#   1. Create a bucket on Cloudflare R2
#   2. Generate an R2 API token (Account → R2 → Manage R2 API Tokens)
#   3. Run: python scripts/upload_to_r2.py  (once, CPU pod is enough)
#   4. Set R2_ENABLED=true in your RunPod endpoint environment variables
#
# R2_ENABLED=false
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=flux-models
